                $fallbackImg = asset('images/bg3.jpeg');
            } elseif(str_contains($katLower, 'gedung')) {
                $fallbackImg = asset('images/menara-songket.png');
            }

            $spImg = $sp->foto_utama ? asset('storage/' . $sp->foto_utama) : $fallbackImg;

            $kondisiClass = 'baik';
